# Copy to .env.local (never commit it). Both values are in Supabase > Project Settings > API.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# The anon / publishable key. Safe to ship to the browser; RLS does the real gating.
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# Web Push (optional). Generate once: npx web-push generate-vapid-keys. Public key goes here; private key goes to the Edge Function secrets.
VITE_VAPID_PUBLIC_KEY=
